generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  category  String    @default("Technology")
  likes     Int       @default(0)
  createdAt DateTime  @default(now())
  Comment   Comment[]
}

model Like {
  id     Int    @id @default(autoincrement())
  postId Int
  userId String

  @@unique([postId, userId]) // 🔥 1 user 1 like
}

model User {
  id       Int    @id @default(autoincrement())
  username String
  password String
}

model Comment {
  id        Int      @id @default(autoincrement())
  name      String
  content   String
  postId    Int
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, approved])
}
